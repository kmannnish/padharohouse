rules_version = '2';

// Padharo House — Firestore security rules
// Paste into: Firebase console -> Firestore Database -> Rules -> Publish
//
// The admin console hides things per role, but THESE rules are the real
// boundary: they are evaluated on Google's servers and cannot be bypassed by
// editing the page, calling the API directly, or guessing document IDs.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // role is read from users/{uid}.role — missing doc means no access
    function roleOf() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }
    function isSuper() { return signedIn() && roleOf() == 'super_admin'; }
    // a suspended account keeps its role but loses access everywhere
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', true) == true;
    }
    function isStaff() {
      return isActive() && roleOf() in ['super_admin', 'manager', 'caretaker', 'accountant'];
    }
    // a granular tick-box from the Team screen; super_admin implicitly has all
    function hasPerm(p) {
      return isActive() && (roleOf() == 'super_admin'
        || get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('permissions', {}).get(p, false) == true);
    }

    // ---- who may use the console -------------------------------------------
    // A super admin manages the team from the browser (Team & Roles screen).
    // Guard rails that cannot be bypassed from the page:
    //   * only a super_admin may create, change or remove a member
    //   * the role must be one of the four known roles
    //   * nobody can change their OWN role or suspend themselves, so a
    //     super admin can never accidentally lock themselves out, and a
    //     compromised lower role can never promote itself
    // Deleting this document revokes console access. It does NOT delete the
    // Firebase Authentication account — remove that in the Auth console too if
    // you want the sign-in gone entirely.
    function validRole(r) { return r in ['super_admin', 'manager', 'caretaker', 'accountant']; }
    function selfDoc(uid) { return request.auth.uid == uid; }
    match /users/{uid} {
      allow read: if signedIn() && (selfDoc(uid) || hasPerm('manageTeam'));
      allow create: if isSuper() && validRole(request.resource.data.role);
      allow update: if isSuper()
                    && validRole(request.resource.data.role)
                    && (!selfDoc(uid) || (
                         request.resource.data.role == resource.data.role
                         && request.resource.data.get('active', true) == true
                       ));
      allow delete: if isSuper() && !selfDoc(uid);
    }

    // ---- audit trail -------------------------------------------------------
    // Append-only: staff may record what they did, nobody may edit or erase
    // history, and only a super admin can read it back.
    match /audit_log/{docId} {
      allow create: if isStaff()
                    && request.resource.data.byUid == request.auth.uid
                    && request.resource.data.action is string
                    && request.resource.data.action.size() < 60;
      allow read: if hasPerm('manageTeam');
      allow update, delete: if false;
    }

    // ---- public website reads ----------------------------------------------
    // The live site needs the mode switch, the tariff, the packages and the
    // blocked dates in order to render. None of these contain personal data.
    match /config/{docId} {
      allow read: if true;
      allow write: if isSuper();
    }
    match /property/{docId} {
      allow read: if true;
      allow write: if isSuper();
    }
    match /packages/{docId} {
      allow read: if true;
      allow write: if isSuper();
    }
    match /blocked_dates/{docId} {
      allow read: if true;                 // public availability calendar
      // A guest may HOLD a free night when they submit a booking, but only
      // create: an existing hold or host block can never be overwritten or
      // deleted from the website, so live reservations cannot be tampered with.
      allow create: if isStaff() || (
                      request.resource.data.source == 'guest_booking'
                      && request.resource.data.date is string
                      && request.resource.data.date.size() == 10
                      && request.resource.data.bookingId is string
                      && request.resource.data.bookingId.size() > 4
                      && request.resource.data.bookingId.size() < 40
                    );
      allow update, delete: if isStaff();  // only the host unblocks
    }

    // ---- guest data: staff only --------------------------------------------
    // Bookings hold names, phone numbers and payment references, so they are
    // never publicly readable. Deletion is restricted to a super admin so a
    // manager cannot erase the financial record (they can mark it cancelled).
    //
    // A visitor may CREATE their own booking request from the website, with the
    // shape below enforced. They cannot read any booking back (not even their
    // own) and cannot update one, so nobody can browse guest data or alter a
    // reservation. The host verifies the UTR and the amount before confirming —
    // treat totals submitted here as a claim, not as proof of payment.
    function isGuestBooking() {
      let d = request.resource.data;
      return d.status == 'PENDING_VERIFICATION'
             && d.source == 'website'
             && d.advancePaid == 0
             && d.utrVerified == false
             && d.cancelled == false
             && d.keys().hasAll(['bookingId','guestName','phone','email','checkIn','checkOut','nights','guests','totalAmount','advanceDue','utr'])
             && d.bookingId is string && d.bookingId.size() > 4 && d.bookingId.size() < 40
             && d.guestName is string && d.guestName.size() > 1 && d.guestName.size() < 120
             && d.phone is string && d.phone.size() > 7 && d.phone.size() < 25
             && d.email is string && d.email.size() < 160
             && d.checkIn is string && d.checkIn.size() == 10
             && d.checkOut is string && d.checkOut.size() == 10
             && d.checkIn < d.checkOut
             && d.nights is int && d.nights > 0 && d.nights <= 60
             && d.guests is int && d.guests > 0 && d.guests <= 6
             && d.totalAmount is number && d.totalAmount >= 0 && d.totalAmount <= 2000000
             && d.advanceDue is number && d.advanceDue >= 0 && d.advanceDue <= 2000000
             && d.utr is string && d.utr.size() <= 24;
    }
    match /bookings/{docId} {
      allow read: if isStaff();
      allow create: if isStaff() || isGuestBooking();
      allow update: if isStaff();
      allow delete: if isSuper();
    }

    // Enquiries: anyone may SUBMIT one from the website, but only staff can
    // read them back. A visitor cannot list or read other people's enquiries.
    match /leads/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() < 40;
      allow read, update: if isStaff();
      allow delete: if isSuper();
    }

    // Visit pings are write-only from the site and readable only by staff, so
    // visitor referrers/devices are not exposed publicly.
    match /traffic_analytics/{docId} {
      allow create: if true;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // WhatsApp message templates — staff only.
    match /templates/{docId} {
      allow read, write: if isStaff();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
